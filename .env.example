# ---------------------------------------------------------------------------
# Vrijdag — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must stay that way.
# Anything marked SERVER-ONLY must never be shipped inside the Flutter bundle.
# See docs/architecture/05-security.md (local copy).
# ---------------------------------------------------------------------------

# --- Environment -----------------------------------------------------------
# local | staging | production
# Passed to Flutter as: --dart-define=VRIJDAG_ENV=staging
VRIJDAG_ENV=local

# --- Supabase (client-safe — publishable / anon key only) --------------------
# Local defaults (supabase start): http://127.0.0.1:54421 + demo anon key
# Ports are offset in supabase/config.toml so another local stack can keep 54321.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SERVER-ONLY: Edge Functions, CI, migrations) ----------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Google Calendar OAuth (SERVER-ONLY for the secret) --------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=

# --- Weather provider (SERVER-ONLY) ----------------------------------------
WEATHER_PROVIDER=
WEATHER_API_KEY=

# --- Observability (client-safe DSN / project keys only) -------------------
# Sentry EU project DSN
SENTRY_DSN=
# PostHog EU project API key (mobile)
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Apple TestFlight (SERVER-ONLY — never in Flutter bundle) --------------
# App Store Connect API key (preferred) or app-specific password
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=
# Fallback: Apple ID + app-specific password for Transporter
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=

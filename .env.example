# ---------------------------------------------------------------------------
# Vrijdag — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must stay that way.
# Anything marked SERVER-ONLY must never be shipped inside the Flutter bundle.
# See docs/architecture/05-security.md.
# ---------------------------------------------------------------------------

# --- Supabase (client-safe) ------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SERVER-ONLY: Edge Functions, CI, migrations) ----------------
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# --- Google Calendar OAuth (SERVER-ONLY for the secret) --------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=

# --- Weather provider (SERVER-ONLY) ----------------------------------------
# Provider selected per docs/integrations/weather.md
WEATHER_PROVIDER=
WEATHER_API_KEY=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
ANALYTICS_WRITE_KEY=

# --- Environment flag ------------------------------------------------------
# local | staging | production
VRIJDAG_ENV=local
